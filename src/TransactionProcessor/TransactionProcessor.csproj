<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 by default. dotnet publish -p:ProcessorTargetFramework=net8.0 builds the App Service fallback. -->
    <ProcessorTargetFramework Condition="'$(ProcessorTargetFramework)' == ''">net10.0</ProcessorTargetFramework>
    <TargetFramework>$(ProcessorTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
  </ItemGroup>

</Project>
