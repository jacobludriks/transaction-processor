<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoadGenerator\LoadGenerator.csproj" />
  </ItemGroup>

  <!-- The handler tests' wslc SQL Server fixture and fakes are shared by linking the sources. -->
  <ItemGroup>
    <Compile Include="..\TransactionProcessor.Tests\Infrastructure\Fakes.cs" Link="Infrastructure\Fakes.cs" />
    <Compile Include="..\TransactionProcessor.Tests\Infrastructure\TestDatabase.cs" Link="Infrastructure\TestDatabase.cs" />
    <Compile Include="..\TransactionProcessor.Tests\Infrastructure\WslcSqlServerFixture.cs" Link="Infrastructure\WslcSqlServerFixture.cs" />
  </ItemGroup>

</Project>
